{
  "name": "@fingerprint/aws-cloudfront-proxy",
  "version": "2.2.0",
  "description": "Fingerprint CloudFront lambda@edge function",
  "author": "FingerprintJS, Inc (https://fingerprint.com)",
  "license": "MIT",
  "private": true,
  "main": "dist/fingerprintjs-pro-cloudflare-lambda-function.js",
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && NODE_OPTIONS=\"--max_old_space_size=4098\" vite build && NODE_OPTIONS=\"--max_old_space_size=4098\" BUILD_TARGET=mgmt vite build && cp cloudformation/template.yml dist/template.yml",
    "build:release": "pnpm build && pnpm prepare-package",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:diff": "vitest run --coverage --reporter json --outputFile.json=report.json",
    "test:dts": "tsc --project tsconfig.eslint.json",
    "prepare-package": "bash ./scripts/preparePackage.sh",
    "changeset:publish": "HUSKY=0 changeset publish",
    "changeset:version": "changeset version"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.989.0",
    "@aws-sdk/client-lambda": "^3.989.0",
    "@aws-sdk/client-secrets-manager": "^3.989.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.832.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.8.1",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.0.2",
    "@fingerprintjs/conventional-changelog-dx-team": "^0.1.0",
    "@fingerprintjs/eslint-config-dx-team": "^3.1.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.3.1",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-istanbul": "^5.0.3",
    "adm-zip": "^0.5.16",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.ts": "pnpm run lint:fix",
    "*.tsx": "pnpm run lint:fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
