{
  "extends": "@fingerprintjs/tsconfig-dx-team/tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "outDir": "dist",
    "module": "es6",
    "moduleResolution": "node",
    "target": "es2020",
    "esModuleInterop": true,
    "noEmitOnError": true,
    "strict": true,
    "types": ["@types/aws-lambda", "@types/jest", "@types/node"]
  },
  "files": ["proxy/app.ts", "mgmt-lambda/app.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
